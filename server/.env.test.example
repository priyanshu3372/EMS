# Copy to .env.test. Loaded ON TOP of .env when NODE_ENV=test, so ONLY the
# database belongs here — JWT secrets and everything else are inherited.
#
# Why a second database at all: the suite creates and deletes rows freely. If it
# ran against the development database it would keep wiping your own data, and
# the only thing stopping it from one day running against production is which
# URL happened to be loaded. A separate file makes that impossible to do by
# accident.
#
# Local Postgres has no connection pooler and no SSL, so both URLs are identical
# here — unlike Neon, where DATABASE_URL is pooled and DIRECT_URL is not.

DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/ems_test"
DIRECT_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/ems_test"
